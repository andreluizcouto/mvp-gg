# Renomeie esse arquivo para .env e preencha suas chaves

# === Obrigatorios (backend) ===
RIOT_API_KEY=sua_chave_riot_aqui
GEMINI_API_KEY=sua_chave_gemini_aqui
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_service_role_key_aqui
# Token interno para automacoes servidor-servidor e rotas administrativas
APP_TOKEN=seu_token_interno_aqui
# Token dedicado do app local (.exe). Nao embuta esse valor no codigo-fonte.
# LOCAL_APP_TOKEN=seu_token_app_local_aqui
# Alternativa ao APP_TOKEN para chamadas internas servidor-servidor
# INTERNAL_BEARER_TOKEN=seu_bearer_interno_aqui

